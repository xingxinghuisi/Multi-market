# =========================================================
# Market Radar - Environment Variables
# =========================================================

# ---------------------------------------------------------
# Groq AI
# Required for Groq news analysis
# ---------------------------------------------------------

GROQ_API_KEY=your_groq_api_key_here


# ---------------------------------------------------------
# Telegram
# Required for price/news Telegram notifications
# ---------------------------------------------------------

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here


# ---------------------------------------------------------
# Binance
# Optional.
# Leave empty if Binance can be accessed directly.
# Example for local Clash/Mihomo:
# http://127.0.0.1:7897
# ---------------------------------------------------------

BINANCE_PROXY_URL=http://127.0.0.1:7897


# ---------------------------------------------------------
# News Worker
# ---------------------------------------------------------

MARKET_RADAR_API_URL=http://127.0.0.1:8000

# Scan interval in seconds
# Default: 1800 = 30 minutes
NEWS_POLL_INTERVAL=1800

# Number of Google News items fetched per watched asset
NEWS_FETCH_LIMIT=3

# HTTP request timeout in seconds
NEWS_REQUEST_TIMEOUT=180

# Maximum Groq analyses per scan cycle
NEWS_MAX_AI_PER_CYCLE=12

# Delay between assets in seconds
NEWS_ASSET_INTERVAL=1


# ---------------------------------------------------------
# News Telegram alert thresholds
# ---------------------------------------------------------

# Minimum AI impact score required for push
NEWS_ALERT_IMPACT_MIN=60

# Minimum relevance score required for push
NEWS_ALERT_RELEVANCE_MIN=70


# ---------------------------------------------------------
# Infoway
# Optional / currently used by Infoway-related provider/test
# ---------------------------------------------------------

INFOWAY_API_KEY=your_infoway_api_key_here


# ---------------------------------------------------------
# Legacy OpenAI news analyzer
# Currently not used by the Groq production news pipeline
# ---------------------------------------------------------

OPENAI_NEWS_MODEL=

# Hyperliquid / trade.xyz automatic wallet discovery (no private key needed)
# Bounded address pool; only enabled markets from the verified xyz catalog.
WHALE_POSITION_ADDRESS_CAP=2000
# Optional HTTP proxy for both public REST and WebSocket requests.
HYPERLIQUID_PROXY=

# Lighter MAINNET public accounts (not Robinhood); no API key/private key needed.
# One discovery replica; whale_position_worker delivers notifications for both venues.
WHALE_LIGHTER_ADDRESS_CAP=2000
LIGHTER_PROXY=

# Gemini on Google Cloud (Vertex): opt in only after Cloud project and ADC are ready.
# Standard GLOBAL text inference; no web search/tools or automatic paid retries.
GEMINI_ENABLED=0
GOOGLE_CLOUD_PROJECT=
GEMINI_MODEL=gemini-3.1-flash-lite
# Monthly gross usage estimate, not the credit balance. Warn, do not stop service.
GEMINI_MONTHLY_WARNING_USD=8.5
# Set to the existing MIRAO account that owns the Google credit and bound Telegram.
GEMINI_BUDGET_USERNAME=default
# Shared across users; deterministic signals still work when the daily AI cap is reached.
GEMINI_MAX_CALLS_PER_DAY=100
# Optional compose.gemini.yaml ADC file, kept outside the source tree / Docker context.
GEMINI_CREDENTIALS_FILE=
# Optional ACTUAL Cloud Budget Pub/Sub pull subscription and expected budget UUID.
# Configure a USD monthly budget excluding credits, filtered to this project's Vertex service.
GEMINI_BILLING_SUBSCRIPTION=
GEMINI_BILLING_BUDGET_ID=
